# ==========================================
# openSEO Environment Configuration Template
# ==========================================

# [Application Info]
SITE_NAME="My Platform"
SITE_URL="https://example.com"
SITE_DOMAIN="example.com"
PORT=8790
NODE_ENV=development

# [Database Configuration]
# If DATABASE_URL is empty, openSEO automatically uses embedded SQLite (./data/openseo.sqlite).
# To use PostgreSQL in production, provide a standard connection string:
# DATABASE_URL=postgres://user:password@localhost:5432/openseo
DATABASE_URL=

# [Google Search Console (GSC) Integration]
# Target site URL registered in Google Search Console (must match protocol and trailing slash or sc-domain:)
# Examples: "https://example.com/" or "sc-domain:example.com"
GSC_SITE_URL=https://example.com/

# Service Account credentials for GSC (optional, required only for automatic daily sync)
# Option A: Inline environment variables
GSC_CLIENT_EMAIL=
GSC_PRIVATE_KEY=

# Option B: Path to downloaded Service Account JSON key file
GSC_KEY_FILE=./config/gsc-service-account.json

# [Demo / Mock Mode]
# When set to true or when no database/GSC is configured, openSEO boots with realistic mock data
DEMO_MODE=true

# [Frontend Vite Config]
VITE_API_BASE=http://localhost:8790
VITE_SITE_NAME="My Platform"
VITE_SITE_URL="https://example.com"
